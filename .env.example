# ==============================================================================
# CENTRAL TRASH AGENT BALI - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Kosongkan GEMINI_API_KEY untuk berjalan dalam mode demo (klasifikasi & rute mock berlabel).
# Jika kunci diatur, kegagalan klasifikasi mengembalikan galat. Penjelasan rute mencoba
# model berikutnya, lalu templat berlabel template-fallback. Kresna menandai source=template.
# Anda dapat mengisi hingga 4 kunci API (dari proyek Google AI Studio berbeda) untuk failover otomatis saat terkena batas kuota (429):
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Pemisahan model Gemini:
# - gemini-3.5-flash: klasifikasi multimodal citra/teks laporan warga & agen Kresna.
# - gemini-3.5-flash-lite: perangkuman narasi penjelasan rute VRP.
# Jika dikosongkan, kode memakai gemini-2.5-flash dan gemini-2.5-flash-lite.
# Penjelasan rute juga mencoba model klasifikasi dan id 2.5/3.5 yang belum dicoba.
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash
GEMINI_EXPLAIN_MODEL=gemini-3.5-flash-lite

# Cookie sesi httpOnly. Wajib di produksi, minimal 16 karakter. Kosong = masuk gagal tertutup.
SESSION_SECRET=

# Opsional. Kosongkan agar kata sandi demo yang sudah dibagikan ke juri tetap berlaku.
DEMO_WARGA_PASSWORD=
DEMO_PETUGAS_PASSWORD=

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Atur variabel di bawah jika ingin menggunakan database Supabase persisten.
# Jika dikosongkan, aplikasi secara otomatis menggunakan in-memory store server-side (data/reports.json, data/facilities.json, dll.).
#
# URL Proyek Supabase (contoh: https://xyzcompany.supabase.co):
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Kunci Anon / Public (Publishable Key):
# Diambil dari Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' / 'public' (biasanya berawalan sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci Service Role (Secret Key) - WAJIB DI SISI SERVER & SEEDING:
# Diambil dari Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'service_role' (secret)
# PERINGATAN: Kunci ini melewati Row Level Security (RLS). Jangan ekspos ke klien!
SUPABASE_SERVICE_ROLE_KEY=
