# Kosongkan GEMINI_API_KEY untuk berjalan dalam mode demo.
# Klasifikasi dan penjelasan rencana akan mengembalikan teks mock berlabel, dan meta.mode menjadi "demo".
# Jika kunci diatur, kegagalan pemanggilan model akan mengembalikan galat (tidak diam-diam beralih kembali ke mock).
# Anda dapat mengisi hingga 4 kunci API (dari proyek Google AI Studio berbeda) untuk failover otomatis saat terkena batas kuota (429):
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Pemisahan model berdasarkan tugas.
# Direkomendasikan: gemini-3.5-flash untuk klasifikasi multimodal citra/teks laporan warga serta percakapan asisten personal warga (Kresna).
# gemini-3.5-flash-lite untuk perangkuman narasi penjelasan rute armada VRP.
# Kode secara otomatis fallback ke gemini-2.5-flash dan gemini-2.5-flash-lite jika variabel di bawah dikosongkan.
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash
GEMINI_EXPLAIN_MODEL=gemini-3.5-flash-lite

# Atur KEDUA variabel di bawah untuk menggunakan adaptor Supabase (PostgreSQL persisten). Jika tidak, aplikasi menggunakan penyimpanan memori (in-memory store).
# SUPABASE_SERVICE_ROLE_KEY melewati row level security (RLS). Gunakan hanya di sisi server.
# Jangan beri awalan NEXT_PUBLIC_ dan jangan mengimpor klien Supabase dari komponen klien.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
