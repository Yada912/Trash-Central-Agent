# Leave GEMINI_API_KEY empty to run in demo mode.
# Classification and plan explanations then return labelled mock text, and meta.mode is "demo".
# When the key is set, a failed model call returns an error. The app does not silently switch back to mock output.
GEMINI_API_KEY=

# Set BOTH variables to use the Supabase adapter. Otherwise the app uses the in-memory store.
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Use it only on the server.
# Do not prefix it with NEXT_PUBLIC_ and do not import the Supabase client from a client component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
